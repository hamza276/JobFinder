# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pkjobs

# Redis (used by Celery)
REDIS_URL=redis://localhost:6379/0

# SearXNG (self-hosted, run via Docker)
SEARXNG_URL=http://localhost:8888

# Scrapling (open-source local scraper)
# auto chooses HTTP first for simple pages, browser/stealth fetchers for JS-heavy or protected sites.
SCRAPLING_FETCH_MODE=auto
SCRAPLING_HEADLESS=true
SCRAPLING_TIMEOUT_MS=30000
SCRAPLING_WAIT_MS=1000
SCRAPLING_SOLVE_CLOUDFLARE=false
SCRAPLING_PROXY=

# LLM Configuration
# Choose one: "openai" | "anthropic" | "ollama"
LLM_PROVIDER=openai
LLM_MODEL=                    # leave empty for provider default

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (if LLM_PROVIDER=ollama, for local/free usage)
OLLAMA_BASE_URL=http://localhost:11434

# CORS (comma-separated in production)
CORS_ORIGINS=["http://localhost:5173"]
